def juego5():

    print("\n===== ADIVINA EL NÚMERO =====")

    numero = random.randint(1, 20)
    intentos = 5

    while intentos > 0:

        print("\nIntentos restantes:", intentos)

        respuesta = input("Adivina un número del 1 al 20: ")

        if not respuesta.isdigit():
            print("Ingresa un número válido.")
            continue

        respuesta = int(respuesta)

        if respuesta == numero:
            print("\n¡¡FELICITACIONES!!")
            print("Adivinaste el número.")
            break

        elif respuesta < numero:
            print("El número es mayor.")

        else:
            print("El número es menor.")

        intentos -= 1

    if intentos == 0:
        print("\nPerdiste.")
        print("El número era:", numero)

    input("\nPresione Enter para volver al menú...")
