def juego1():
    numeros = [8, 15, 7, 20, 11, 9, 14]
    print("\n===== ¿PAR O IMPAR? =====")

    puntos = 0
    nivel = 1

    for numero in numeros:

        print("\nNivel", nivel)
        print("Número:", numero)

        respuesta = input("¿Es Par o Impar?\n"
                          "Opciones: P = Par | I = Impar: ").upper()

        if numero % 2 == 0:
            correcta = "P"
        else:
            correcta = "I"

        if respuesta == correcta:
            print("¡Correcto!\n")
            puntos += 1
            nivel += 1
        else:
            print("\n************")
            print("  PERDISTE")
            print("************")
            print("La respuesta correcta era:", correcta)
            print("Puntaje:", puntos)

            input("\nPresione Enter para volver al menú...")
            return

    print("\n¡¡FELICITACIONES!!")
    print("Completaste todos los niveles.")
    print("Puntaje final:", puntos)

    input("\nPresione Enter para volver al menú...")


