import random

def juego3(): 
    print("\n===== PIEDRA, PAPEL O TIJERA =====")

    puntos_jugador = 0
    puntos_pc = 0

    while puntos_jugador < 3 and puntos_pc < 3:

        print("\nMarcador")
        print("Jugador:", puntos_jugador)
        print("Computadora:", puntos_pc)

        jugador = input("\nElige una opción:\n"
                        "P = Piedra\n"
                        "A = Papel\n"
                        "T = Tijera\n"
                        "Opción: ").upper()

        if jugador not in ["P", "A", "T"]:
            print("Opción inválida.")
            continue

        computadora = random.choice(["P", "A", "T"])

        if computadora == "P":
            print("La computadora eligió: Piedra")
        elif computadora == "A":
            print("La computadora eligió: Papel")
        else:
            print("La computadora eligió: Tijera")

        if jugador == computadora:
            print("¡Empate!")

        elif (jugador == "P" and computadora == "T") or \
             (jugador == "A" and computadora == "P") or \
             (jugador == "T" and computadora == "A"):
            print("¡Ganaste la ronda!")
            puntos_jugador += 1

        else:
            print("Perdiste la ronda.")
            puntos_pc += 1

    print("\n========================")

    if puntos_jugador == 3:
        print("¡¡FELICITACIONES!!")
        print("Ganaste la partida.")
    else:
        print("La computadora ganó la partida.")

    print("\nResultado final")
    print("Jugador:", puntos_jugador)
    print("Computadora:", puntos_pc)

    input("\nPresione Enter para volver al menú...")



def juego4():
    print("Ahorcado")
    palabra = "python"
    oculta = "_" * len(palabra)
    intentos = 6

    while intentos > 0 and "_" in oculta:

        print("Palabra:", oculta)
        print("Intentos:", intentos)

        letra = input("Ingresa una letra: ")

        nueva = ""

        for i in range(len(palabra)):
            if palabra[i] == letra:
                nueva += letra
            else:
                nueva += oculta[i]

        if nueva == oculta:
            intentos -= 1
            print("La letra no está.")
        else:
            oculta = nueva
            print("¡Correcto!")

    if "_" not in oculta:
        print("¡Ganaste!")
        print("La palabra era:", palabra)
    else:
        print("\nPerdiste.")
        print("La palabra era:", palabra)
    
    input("\nPresione Enter para volver al menú...")


